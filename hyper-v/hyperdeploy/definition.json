{
    "DeploymentOptions": {
        "StartAfterCreation": true,
        "Parallel": false
    },
    "VMs": [
        {
            "Name": "pfSense",
            "ProcessorCount": 2,
            "MemoryStartupBytes": "2GB",
            "MemoryMaximumBytes": "2GB",
            "HyperVServers": [
                {
                    "Name": "hyperv01.example.local",
                    "SwitchName": "Lab-External-vSwitch",
                    "GoldenImagePath": "D:\\Hyper-V\\Golden\\pfsense-2.9.vhdx",
                    "VMHardDiskPath": "F:\\Hyper-V\\Virtual-Hard-Disks"
                }
            ],
            "PostCreate": {
                "Scripts": [
                    ".\\pfsense-postcreate.ps1"
                ]
            }
        },
        {
            "Name": "ubuntu-2404-0",
            "ProcessorCount": 2,
            "MemoryStartupBytes": "4GB",
            "MemoryMaximumBytes": "4GB",
            "Replicas": 3,
            "HyperVServers": [
                {
                    "Name": "hyperv01.example.local",
                    "SwitchName": "jumpcloud-lab-net",
                    "GoldenImagePath": "F:\\Hyper-V\\Golden\\ubuntu-24.04-server-cloudimg-amd64.vhdx",
                    "VMHardDiskPath": "F:\\Hyper-V\\Virtual-Hard-Disks",
                    "MaxReplicas": 3
                }
            ],
            "PostCreate": {
                "Scripts": [
                    ".\\ubuntu-postcreate.ps1"
                ]
            }
        }
    ]
}
