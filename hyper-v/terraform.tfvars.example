# Copy to terraform.tfvars and fill in real values.
# Git ignores terraform.tfvars and tracks this example file.

hyperv_host     = "hyperv01.example.local"
hyperv_user     = "Administrator"
hyperv_password = "CHANGE_ME"
hyperv_https    = true
hyperv_insecure = true

# Host storage
vm_path = "F:/Hyper-V/Virtual-Hard-Disks"

# Sysprepped Windows 11 golden image, copied per VM and grown to 64 GiB
windows_source_vhdx = "D:/Hyper-V/Golden/win11-jumpcloud.vhdx"

# Windows 11 JumpCloud VMs (JUMPCLOUD-TEST-1, -2, ...)
windows_vm_count = 3
