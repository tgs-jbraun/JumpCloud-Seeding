# Written with AI assistance: Claude Opus 5.5 (Anthropic), using Claude Code.

# Copy to terraform.tfvars and fill in real values.
# Git ignores terraform.tfvars and tracks this example file.

xoa_url      = "wss://xo.example.local"
xoa_user     = "admin@example.local"
xoa_password = "CHANGE_ME"
xoa_insecure = true

# Ubuntu Server 24.04 VM
vm_name              = "ubuntu-2404"                 # prefix: VMs become ubuntu-2404-01, -02, ...
vm_count             = 3
vm_ssh_public_key    = ""                          # e.g. "ssh-ed25519 AAAA... you@host"

# Windows 11 JumpCloud VMs (<windows_vm_prefix>1, 2, ...)
windows_vm_count     = 3
windows_vm_prefix    = "JUMPCLOUD-TEST-"

# What already exists in XO
pool_name        = "my-xcp-pool"
sr_name          = "my-storage-repository"
wan_network_name = "LAN"                   # pfSense WAN
lab_network_name = "jumpcloud-lab-net"     # SDN private network
lab_net_cidr     = "192.168.1.0/24"        # pfSense serves DHCP here, from .1

ubuntu_template  = "Ubuntu 24.04 Cloud-Init (Hub)"
pfsense_template = "pfSense 2.6 (Hub)"
windows_template = "Windows 11 JumpCloud - Template"